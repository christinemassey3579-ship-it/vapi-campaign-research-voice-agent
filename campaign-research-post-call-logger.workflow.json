{
  "name": "Campaign Research – Post-Call Logger",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vapi-campaign-research",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "64425ade-e8cf-4c12-93f4-f33a955b5c1e",
      "name": "VAPI End-of-Call Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        240,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.message.type }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "end-of-call-report"
            }
          ],
          "combinator": "and"
        }
      },
      "id": "6d20d636-4f5e-4d2c-93bd-98a3e41b271e",
      "name": "Is End-of-Call Report?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        304
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Transcript:\n{{ $json.body.message.artifact?.transcript || $json.body.message.transcript || \"\" }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a transcript analyzer. Extract the following fields from the transcript: prospect_name, awareness, current_tool, priority_level, open_to_followup. Return only these fields as plain text labels and values.\n\nAlso add intent_signal using these rules:\n- Hot: priority_level is High AND open_to_followup is Yes\n- Warm: open_to_followup is Yes but priority_level is Medium or Low, OR priority_level is High but open_to_followup is No\n- Cold: open_to_followup is No and priority_level is Medium, Low or Not answered, or the caller ended the call early\n\nValue rules:\n- awareness: Yes / No / Somewhat. \"I don't know\", \"not sure\" or no clear answer = Not answered.\n- current_tool: the tool name the caller gives (e.g. Zendesk, Freshdesk, Spreadsheets and WhatsApp). If the caller says they use no tool (\"no\", \"nothing\", \"none\"), write None. Never write Yes or No here.\n- priority_level: High / Medium / Low only if the caller gave or confirmed that level. If the assistant said it would note it as not answered, or the caller did not know, write Not answered.\n- open_to_followup: Yes / No. \"Maybe no\" = No, \"maybe yes\" / \"sure\" = Yes.\n- When the assistant confirms an answer back and the caller agrees, use the confirmed value.\nIf a field was not answered, write \"Not answered\". Do not guess."
        }
      },
      "id": "404b6bf2-c3a7-4a87-a656-ff357aef7c5b",
      "name": "AI Transcript Extractor",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        736,
        304
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "temperature": 0
        }
      },
      "id": "243eaafa-16ce-4f1d-8266-5fbbf9ddcaf8",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        672,
        544
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_GEMINI_CREDENTIAL_ID",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{ \"prospect_name\": \"Rahul Mehta\", \"awareness\": \"Somewhat\", \"current_tool\": \"Zendesk\", \"priority_level\": \"High\", \"open_to_followup\": \"Yes\", \"intent_signal\": \"Hot\" }"
      },
      "id": "4d1c6ad9-006c-461b-ba96-823761d7ab22",
